{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SERVER_URL": "https://huddle-server.fly.dev" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_SERVER_URL": "https://huddle-server.fly.dev" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_SERVER_URL": "https://huddle-server.fly.dev" }
    }
  },
  "submit": { "production": {} }
}
