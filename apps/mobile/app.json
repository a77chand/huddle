{
  "expo": {
    "name": "Huddle",
    "slug": "huddle",
    "scheme": "huddle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.huddle.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "bluetooth-central",
          "bluetooth-peripheral"
        ],
        "NSBluetoothAlwaysUsageDescription": "Huddle uses Bluetooth to notice when friends in your group are nearby, using anonymous IDs that change every 15 minutes.",
        "NSMicrophoneUsageDescription": "Huddle records a short voice note only when you choose to send one with an alert."
      }
    },
    "android": {
      "package": "dev.huddle.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B1033",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "VIBRATE",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Huddle shares your location with your group when you check in or ask for help.",
          "locationAlwaysAndWhenInUsePermission": "If you turn on live location, Huddle shares your position with your group during a huddle, even when the app is closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C5CFF",
          "defaultChannel": "alert",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-build-properties",
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ]
    ],
    "extra": {
      "serverUrl": "http://localhost:8787"
    }
  }
}
