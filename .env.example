# Copy to .env. Everything is optional: without these, alerts are logged instead of sent.

# SMS to emergency contacts (https://console.twilio.com). TWILIO_FROM is a number or an MG… messaging service id.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Only needed if you enable "enhanced push security" in your Expo project.
EXPO_ACCESS_TOKEN=

# Set to 1 to log pushes instead of sending them (local development).
PUSH_DISABLED=
